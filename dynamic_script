#!/usr/bin/env bash
set -e

main() {
  # Check if CYFRINUP_ONLY_INSTALL is set and its value
  if [ -n "$CYFRINUP_ONLY_INSTALL" ]; then
    case "$CYFRINUP_ONLY_INSTALL" in
      "aderyn")
        install_package "aderyn"
        ;;
      "safe-hash")
        install_package "safe-hash"
        ;;
      *)
        err "Invalid value for CYFRINUP_ONLY_INSTALL. The only supported value is 'safe-hash'."
        ;;
    esac
  else
    # Default behavior: Install maintained tools only.
    install_package "safe-hash"
    aderyn_retirement_notice
  fi
}

install_package() {
  local package="$1"

  case "$package" in
    "aderyn")
      aderyn_retirement_notice
      err "Aderyn was not installed: it has been retired."
      ;;
    "safe-hash")
      need_cmd curl
      say "Installing latest Safe-Hash"
      ensure curl --proto '=https' --tlsv1.2 -LsSf https://github.com/cyfrin/safe-hash-rs/releases/latest/download/safe-hash-installer.sh | bash
      say "Safe-Hash installation complete!"
      ;;
    *)
      err "Unknown package: $package"
      ;;
  esac
}

# Loud, bold notice (on stderr) telling users how to remove Aderyn.
# Colors are only used when stderr is a terminal.
aderyn_retirement_notice() {
  local bold="" reset=""
  if [ -t 2 ]; then
    bold="$(printf '\033[1;31m')"
    reset="$(printf '\033[0m')"
  fi

  {
    printf '\n%s' "$bold"
    cat <<'NOTICE'
============================================================================
  ADERYN HAS BEEN RETIRED AND IS NO LONGER MAINTAINED
  Cyfrinup no longer installs or updates it.
  IT IS NOT REMOVED AUTOMATICALLY. TO UNINSTALL IT, RUN:

    rm -f "${CARGO_HOME:-$HOME/.cargo}/bin/aderyn" "${CARGO_HOME:-$HOME/.cargo}/bin/aderyn-update"
    rm -f "$HOME/.cyfrin/bin/aderyn"
    rm -rf "${XDG_CONFIG_HOME:-$HOME/.config}/aderyn"

  Installed it with Homebrew, npm or cargo? Uninstall it with that tool.
============================================================================
NOTICE
    printf '%s\n' "$reset"
  } >&2
}

say() {
  printf 'cyfrinup: %s\n' "$1"
}

warn() {
  say "Warning: ${1}" >&2
}

err() {
  say "$1" >&2
  exit 1
}

need_cmd() {
  if ! check_cmd "$1"; then
    err "Need '$1' (command not found)"
  fi
}

check_cmd() {
  command -v "$1" > /dev/null 2>&1
}

# Run a command that should never fail. If the command fails execution
# will immediately terminate with an error showing the failing
# command.
ensure() {
  if ! "$@"; then err "Command failed: $*"; fi
}

main "$@" || exit 1
